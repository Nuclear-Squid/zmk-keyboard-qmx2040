/dts-v1/;

#include <raspberrypi/rpi_pico/rp2040.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2040-pinctrl.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,flash-controller = &ssi;
        zephyr,code-partition = &code_partition;
    };

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <5>;
        map = <
            RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)
            RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7)
            RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7)
                    RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)
                            RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7)
            RC(0,0) RC(1,0) RC(2,0) RC(3,0) RC(4,0)
        >;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";
        row-gpios
            = <&rp2040_gpio 11 GPIO_ACTIVE_LOW>  // Numbers
            , <&rp2040_gpio 10 GPIO_ACTIVE_LOW>  // Top
            , <&rp2040_gpio  9 GPIO_ACTIVE_LOW>  // Home
            , <&rp2040_gpio  8 GPIO_ACTIVE_LOW>  // Bottom
            , <&rp2040_gpio  0 GPIO_ACTIVE_LOW>  // Thumb
        ;

        col-gpios
            = <&rp2040_gpio  1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // Bépo
            , <&rp2040_gpio  2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // Outer
            , <&rp2040_gpio  3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // Pinky
            , <&rp2040_gpio  4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // Ring
            , <&rp2040_gpio  5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // Middle
            , <&rp2040_gpio  6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // Index
            , <&rp2040_gpio  7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  // Inner
            , <&rp2040_gpio 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  //  Tmx
        ;
    };

    //                                     w   h     x      y   rot rx ry
    #define KEY(x, y) &key_physical_attrs 100 100 (x*50) (y*50)  0  0  0

    physical_layout: physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan>; // Label of the kscan node, optional if all layouts use the same
        transform = <&default_transform>; // Label of the matrix transform for this layout
        keys
            = <KEY(0,  0)>
            , <KEY(1,  1)>
            , <KEY(2,  0)>
            , <KEY(3,  0)>
            , <KEY(4,  0)>
            , <KEY(5,  0)>
            , <KEY(6,  0)>
            , <KEY(7,  1)>

            , <KEY(0,  2)>
            , <KEY(1,  3)>
            , <KEY(2,  2)>
            , <KEY(3,  2)>
            , <KEY(4,  2)>
            , <KEY(5,  2)>
            , <KEY(6,  2)>
            , <KEY(7,  3)>

            , <KEY(0,  4)>
            , <KEY(1,  5)>
            , <KEY(2,  4)>
            , <KEY(3,  4)>
            , <KEY(4,  4)>
            , <KEY(5,  4)>
            , <KEY(6,  4)>
            , <KEY(7,  5)>

            , <KEY(0,  6)>
            , <KEY(2,  6)>
            , <KEY(3,  6)>
            , <KEY(4,  6)>
            , <KEY(5,  6)>
            , <KEY(6,  6)>

            , <KEY(0,  8)>
            , <KEY(3,  8)>
            , <KEY(4,  8)>
            , <KEY(5,  8)>
            , <KEY(6,  8)>
            , <KEY(7,  8)>
            ;
    };
};

rp2040_gpio: &gpio0 {
    status = "okay";
};

&timer {
    status = "okay";
};

&rtc {
    clocks = <&clocks RPI_PICO_CLKID_CLK_RTC>;
    status = "okay";
};

&vreg {
    regulator-always-on;
    regulator-allowed-modes = <REGULATOR_RPI_PICO_MODE_NORMAL>;
};

zephyr_udc0: &usbd {
    status = "okay";
};

&flash0 {
    // Flex 25.xx: W25Q128JV onboard flash, 128M-bit memory (16MB).
    // Flex 26.01: W25Q16JVUX onboard flash, 16M-bit memory (2MB).
    // 2MB is more than enough, so let's use that for all Flex versions.
    reg = <0x10000000 DT_SIZE_M(2)>;

    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        // Reserved memory for the second-stage bootloader
        second_stage_bootloader: partition@0 {
            reg = <0x00000000 0x100>;
            read-only;
        };

        // Usable flash. Starts at 0x100, after the bootloader. The partition
        // size is 2MB minus:
        // - 0x100 bytes taken by the bootloader
        // - 0x20000 bytes (= 128 kB) taken by storage
        code_partition: partition@100 {
            reg = <0x100 (DT_SIZE_M(2) - 0x100 - DT_SIZE_K(128))>;
            read-only;
        };

        // Extra storage needed to store extra tweaks done using ZMK-Studio
        storage_partition: partition@1e0000 {
            reg = <0x1e0000 DT_SIZE_K(128)>;
        };
    };
};

&xosc {
    // Ensure the 12MHz oscillator has enough time to stabilize properly.
    // Required by Flex 25.xx, should be useless with Flex 26.01.
    startup-delay-multiplier = <64>;
};
