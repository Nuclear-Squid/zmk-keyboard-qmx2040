CONFIG_CLOCK_CONTROL=y
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=125000000

# Enable USB CDC ACM logging for debugging (to be removed?)
# CONFIG_ZMK_USB_LOGGING=y
# CONFIG_LOG_PROCESS_THREAD_STARTUP_DELAY_MS=3000

# Enable reset by default
CONFIG_RESET=y

# Code partition needed to target the correct flash range
CONFIG_USE_DT_CODE_PARTITION=y

# Output UF2 by default, native bootloader supports it.
CONFIG_BUILD_OUTPUT_UF2=y

# USB HID
CONFIG_ZMK_USB=y

# I2C key scan
CONFIG_I2C=y
CONFIG_GPIO=y
CONFIG_PINCTRL=y
CONFIG_GPIO_PCA_SERIES=y
CONFIG_ZMK_KSCAN_MATRIX_POLLING=y

# When typing, the right hand seems to randomly stop responding after some time.
# We were unable to figure out a concrete cause, as there seem to be no visible
# issues with the I2C signals under the osciloscope.
# We think this is some kind of race condition, and upping this time-out
# (originally 100ms) seems to fix the issue. Hopefully we have a better fix some day
CONFIG_I2C_DW_RW_TIMEOUT_MS=1000

# Persistent settings support (required by ZMK Studio)
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
