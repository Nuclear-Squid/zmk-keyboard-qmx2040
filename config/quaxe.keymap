#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

// Timing is key
#define TAPPING_TERM       300
#define SHORT_TAPPING_TERM 150
#define QUICK_TAP          200

// Human-readable layer indexes
#define LAYER_MIRROR  1
#define LAYER_NAV     2
#define LAYER_NUM_PAD 3
#define LAYER_CALLUM  4

#define PREV LA(LEFT)
#define NEXT LA(RIGHT)

#define EZ_SK(mod) bsk (mod) (mod)

#define MOD_HOLD(short_name, long_name, _binding, mask) \
    short_name: long_name {                             \
      compatible = "zmk,behavior-mod-hold";             \
      #binding-cells = <2>;                             \
      binding = <_binding>;                             \
      mods-to-hold = <mask>;                            \
    }

&sl { ignore-modifiers; }; // keep one-shot-mods when chained into a one-shot-layer
&sk { quick-release; };    // must-have! (lots of false positives otherwise)

// add our common tap-hold parametesr to the default options
&mt {
  tapping-term-ms = <SHORT_TAPPING_TERM>;
  quick-tap-ms = <QUICK_TAP>;
};

&lt {
  tapping-term-ms = <TAPPING_TERM>;
  quick-tap-ms = <QUICK_TAP>;
};

/ {
  chosen {
    zmk,physical-layout = &physical_quaxe;
  };

  behaviors {
    sc: space_cadet { // same as lt, but with hold-preferred
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      tapping-term-ms = <SHORT_TAPPING_TERM>;
      quick-tap-ms = <QUICK_TAP>;
      flavor = "hold-preferred";
      bindings = <&mo>, <&kp>;
    };

    // like ZMK's sticky key (sk) but with a more robust timing
    osm: one_shot_modifier {
      compatible = "zmk,behavior-macro-one-param";
      #binding-cells = <1>;
      tap-ms = <0>;
      wait-ms = <0>;
      bindings = <&macro_tap &macro_param_1to1 &sk MACRO_PLACEHOLDER>;
    };

    bsk: better_sticky_key {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      tapping-term-ms = <TAPPING_TERM>;
      flavor = "tap-preferred";
      bindings = <&kp>, <&osm>;
    };

    // mod-holds
    MOD_HOLD(mhmo,  momentary_layer_with_held_mods,     &mo,   0xff);
    MOD_HOLD(mhmt,  mod_tap_with_held_mods,             &mt,   0xff);
    MOD_HOLD(mhsc,  space_cadet_with_held_mods,         &sc,   0xff);

    sc_osm: space_cadet_on_one_shot_mod {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      tapping-term-ms = <SHORT_TAPPING_TERM>;
      quick-tap-ms = <QUICK_TAP>;
      flavor = "hold-preferred";
      bindings = <&mo>, <&osm>;
    };

    /* momod: momentary_layer_with_mods { */
    /* }; */

    altgr_td: altgr_td {
      compatible = "zmk,behavior-tap-dance";
      #binding-cells = <0>;
      tapping-term-ms = <QUICK_TAP>;
      bindings = <&mhmt RALT ESC>, <&mhmo LAYER_MIRROR 0>;
    };

    callum_td: callum_td {
      compatible = "zmk,behavior-tap-dance";
      #binding-cells = <0>;
      tapping-term-ms = <1000>;
      bindings = <&sc_osm LAYER_CALLUM LSFT>, <&mhmo LAYER_MIRROR 0>;
      eager;
    };

    nav_td: nav_td {
      compatible = "zmk,behavior-tap-dance";
      #binding-cells = <0>;
      tapping-term-ms = <QUICK_TAP>;
      bindings = <&mhsc LAYER_NAV ENTER>, <&mhsc LAYER_NUM_PAD CAPS>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    base_layer: base_layer {
      display-name = "Base";
      bindings = <
        &none &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp C_MUTE
        &none &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &kp C_VOL_UP
        &none &kp NUBS  &kp A  &kp S  &kp D  &kp F  &kp G  &kp C_VOL_DN
        &none           &kp Z  &kp X  &kp C  &kp V  &kp B
        &none        &none &altgr_td &callum_td &mhsc LAYER_MIRROR SPC &nav_td
      >;
    };

    mirror_layer: mirror_layer {
      display-name = "Mirror";
      bindings = <
        &trans &kp MINUS    &kp N0   &kp N9  &kp N8    &kp N7 &kp N6 &kp DEL
        &trans &EZ_SK(LSFT) &kp P    &kp O   &kp I     &kp U  &kp Y  &kp C_BRI_UP
        &trans &kp SQT      &kp SEMI &kp L   &kp K     &kp J  &kp H  &kp C_BRI_DN
        &trans              &kp FSLH &kp DOT &kp COMMA &kp M  &kp N
        &trans                      &trans &trans &trans &trans &trans
      >;
    };

    navigation_layer: navigation_layer {
      display-name = "Navigation";
      bindings = <
        &trans &trans         &kp F1   &kp F2   &kp F3   &kp F4    &kp F5    &kp C_PP
        &trans &studio_unlock &kp NEXT &kp HOME &kp UP   &kp END   &kp PG_UP &kp C_NEXT
        &trans &trans         &kp PREV &kp LEFT &kp DOWN &kp RIGHT &kp PG_DN &kp C_PREV
        &trans                &trans   &trans   &trans   &trans    &trans
        &trans                &trans   &trans   &trans   &trans    &trans
      >;
    };

    num_pad_layer: num_pad_layer {
      display-name = "NumPad";
      bindings = <
        &trans &kp F11      &kp F10      &kp F9    &kp F8    &kp F7    &kp F6       &trans
        &trans &kp C_BRI_UP &kp KP_SLASH &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_NUM   &trans
        &trans &kp C_BRI_DN &kp KP_N0    &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_MINUS &trans
        &trans              &kp KP_DOT   &kp KP_N1 &kp KP_N2 &kp KP_N3 &trans
        &trans              &trans       &trans    &trans    &trans    &trans
      >;
    };

    callum_mods: callum_mods {
      display-name = "callum_mods";
      bindings = <
        &trans &trans &trans   &trans   &trans   &trans   &trans &trans
        &trans &trans &trans   &kp TAB  &trans   &trans   &trans &trans
        &trans &trans &sk LSFT &sk LGUI &sk LCTL &sk LALT &trans &trans
        &trans        &trans   &trans   &trans   &kp BSPC &trans
        &trans            &trans &trans &trans &trans &trans
      >;
    };

    empty: empty {
      display-name = "empty";
      bindings = <
        &trans &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans &trans &trans
        &trans        &trans &trans &trans &trans &trans
        &trans            &trans &trans &trans &trans &trans
      >;
    };
  };
};
